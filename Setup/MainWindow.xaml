<Window x:Class="Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kingdom: Two Crowns — In-Game Trainer Setup"
        Height="540" Width="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#141416"
        Foreground="#ECECED"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Modern Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="24,0,24,0"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="28,20,28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👑 Kingdom Two Crowns" FontSize="19" FontWeight="Bold" Foreground="#FAFAFA"/>
                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2,6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.5.1 Trainer" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Мастер установки внутриигрового трейнера и лаунчера" FontSize="12.5" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT STACK -->
        <Grid Grid.Row="1" Margin="28,20,28,20">
            <!-- PAGE 1: SETUP OPTIONS -->
            <StackPanel x:Name="pnlOptions" Visibility="Visible">
                <!-- Install Path -->
                <TextBlock Text="Папка установки программы:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtInstallPath" Grid.Column="0" Height="36" Padding="10,8,10,8" Background="#1F1F23" Foreground="#FAFAFA" 
                             BorderBrush="#3F3F46" BorderThickness="1" FontSize="12.5" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Content="Обзор..." Margin="8,0,0,0" Height="36" Click="BtnBrowse_Click"/>
                </Grid>

                <!-- Game Path Detection -->
                <Border Background="#1C1C20" CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,16" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Обнаруженная папка игры (Steam):" FontSize="11.5" FontWeight="SemiBold" Foreground="#71717A"/>
                        <TextBlock x:Name="txtGamePath" Text="Поиск игры..." FontSize="12" Foreground="#34D399" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Checkboxes -->
                <TextBlock Text="Дополнительные параметры:" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                <CheckBox x:Name="chkDesktopShortcut" Content="Создать ярлык на Рабочем столе" IsChecked="True"/>
                <CheckBox x:Name="chkStartMenuShortcut" Content="Создать ярлык в меню «Пуск»" IsChecked="True"/>
                <CheckBox x:Name="chkAutoIntegrate" Content="Прямая интеграция в игру (автозапуск при старте через Steam)" IsChecked="True"/>
            </StackPanel>

            <!-- PAGE 2: PROGRESS -->
            <StackPanel x:Name="pnlProgress" Visibility="Collapsed" VerticalAlignment="Center" Margin="20,0,20,0">
                <TextBlock x:Name="txtProgressTitle" Text="Установка файлов трейнера..." FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,12"/>
                <ProgressBar x:Name="pbProgress" Height="8" Background="#27272A" Foreground="#10B981" BorderThickness="0" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtProgressDetail" Text="Подготовка к установке..." FontSize="12" Foreground="#A1A1AA"/>
            </StackPanel>

            <!-- PAGE 3: FINISHED -->
            <StackPanel x:Name="pnlFinished" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="🎉 Установка успешно завершена!" FontSize="18" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8"/>
                <TextBlock Text="Трейнер и лаунчер Kingdom: Two Crowns готовы к работе. В игре нажимайте F1 для вызова экранного меню или используйте горячие клавиши." 
                           FontSize="13" Foreground="#D4D4D8" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="20"/>
                <CheckBox x:Name="chkLaunchAfter" Content="Запустить Kingdom Two Crowns Trainer прямо сейчас" IsChecked="True"/>
            </StackPanel>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="28,16,28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCancel" Grid.Column="1" Style="{StaticResource SecondaryBtn}" Content="Отмена" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnAction" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="Установить" Click="BtnAction_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
