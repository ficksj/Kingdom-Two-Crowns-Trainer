<Window x:Class="WpfLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kingdom: Two Crowns — Trainer"
        Height="800" Width="720"
        MinHeight="660" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#141416"
        Foreground="#ECECED"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#3F3F46" Margin="1,0,1,0"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Height="24" Width="44">
                            <Border x:Name="Border" CornerRadius="12" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1">
                                <Ellipse x:Name="Dot" Width="16" Height="16" Fill="#A1A1AA" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="DotTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#10B981"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Dot" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#52525B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button Style -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="6" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#71717A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0,18,0"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="24,18,24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Kingdom: Two Crowns" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                        <Border Background="#27272A" CornerRadius="4" Padding="6,2,6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.4.3" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Внутриигровой трейнер • Нажмите F1 в игре для экранного меню" FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource PrimaryBtnStyle}" Click="BtnLaunchGame_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶  Запустить игру" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN SCROLLABLE CHEATS LIST -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,24">

                <!-- SECTION 1: ГЕРОЙ И МАУНТ -->
                <TextBlock Text="ГЕРОЙ И МАУНТ" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="4,8,0,8"/>

                <!-- F1: Menu -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F1" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Внутриигровое меню" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Открывает полноценный экранный интерфейс разработчика прямо в игре" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Открыть" Click="BtnCheat_Click" Tag="TOGGLE_MENU"/>
                    </Grid>
                </Border>

                <!-- F4: Stamina -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F4" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Бесконечная выносливость маунта" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Конь / зверь никогда не устает при длительном беге" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="chkStamina" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleCheat_Click" Tag="INFINITE_STAMINA"/>
                    </Grid>
                </Border>

                <!-- F5: God Mode -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F5" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Бессмертие правителя (God Mode)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Корону невозможно выбить, монарх полностью неуязвим" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="chkGodMode" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleCheat_Click" Tag="INVULNERABLE"/>
                    </Grid>
                </Border>

                <!-- F6: Speed -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F6" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Ускорение игры (Timescale +)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Увеличивает скорость перемещения и общий темп игры" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Ускорить" Click="BtnCheat_Click" Tag="SPEED"/>
                    </Grid>
                </Border>

                <!-- Ctrl+9: Change Mount -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="^9" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Сменить маунта (на лету)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Переключает зверя/скакуна прямо во время игры без поиска стойл" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Сменить" Click="BtnCheat_Click" Tag="CHANGE_MOUNT"/>
                    </Grid>
                </Border>

                <!-- SECTION 2: КАЗНА И РЕСУРСЫ -->
                <TextBlock Text="КАЗНА И РЕСУРСЫ" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="4,16,0,8"/>

                <!-- Ctrl+2: Infinite Wallet (No Spend) -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#10B981" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#064E3B" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="^2" FontSize="11" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Бесконечные монеты и камни (НЕ ТРАТЯТСЯ)" FontSize="13.5" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock Text="Кошелек и сума всегда полны. Тратьте на любые постройки — баланс не уменьшается!" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="chkInfiniteWallet" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleCheat_Click" Tag="INFINITE_WALLET"/>
                    </Grid>
                </Border>

                <!-- F2: Coins -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F2" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Добавить 20 золотых монет" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Моментально наполняет кошелек правителя монетами" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="+20 Монет" Click="BtnCheat_Click" Tag="GIVE_COINS"/>
                    </Grid>
                </Border>

                <!-- F3: Gems -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F3" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Добавить 5 драгоценных камней" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Насыпает самоцветы (Gems) в сумку правителя" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="+5 Камней" Click="BtnCheat_Click" Tag="GIVE_GEMS"/>
                    </Grid>
                </Border>

                <!-- Ctrl+3: Cut Trees -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="^3" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Вырубить весь лес на острове" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Моментально очищает остров от деревьев + дает гору золота монарху" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Срубить лес" Click="BtnCheat_Click" Tag="CUT_ALL_TREES"/>
                    </Grid>
                </Border>

                <!-- SECTION 3: СТРОИТЕЛЬСТВО И ЭПОХИ -->
                <TextBlock Text="СТРОИТЕЛЬСТВО И ЭПОХИ" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="4,16,0,8"/>

                <!-- Ctrl+1: Invulnerable Walls -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="^1" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Неуязвимые стены базы" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Стены становятся бессмертными — монстры и громилы не могут их сломать" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="chkWalls" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleCheat_Click" Tag="INVULNERABLE_WALLS"/>
                    </Grid>
                </Border>

                <!-- F9: Auto-Build -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F9" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Мгновенное строительство (Auto-Build)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Моментальное возведение и улучшение всех стен, башен и ратуши" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="chkAutoBuild" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleCheat_Click" Tag="AUTO_BUILD"/>
                    </Grid>
                </Border>

                <!-- Ctrl+5: Stone Age -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="^5" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Каменный век (Stone Age)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Мгновенное повышение уровня технологий базы до каменного века" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Каменный век" Click="BtnCheat_Click" Tag="SET_TECH_STONE"/>
                    </Grid>
                </Border>

                <!-- Ctrl+6: Iron Age -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="^6" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Железный век (Iron Age)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Мгновенный переход в железный век (максимальные стены и башни)" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Железный век" Click="BtnCheat_Click" Tag="SET_TECH_IRON"/>
                    </Grid>
                </Border>

                <!-- Distribute Archers -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="弓" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Распределить лучников по базе" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Равномерно заполняет башни и левый/правый фланги стрелками" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Распределить" Click="BtnCheat_Click" Tag="DISTRIBUTE_ARCHERS"/>
                    </Grid>
                </Border>

                <!-- SECTION 4: ОБОРОНА И ВРАГИ -->
                <TextBlock Text="ОБОРОНА И ВРАГИ" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="4,16,0,8"/>

                <!-- F7: Defeat Greed -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F7" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Уничтожить всех жадин" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Мгновенно убивает всех жадин (Greed) на текущем острове" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Уничтожить" Click="BtnCheat_Click" Tag="DEFEAT_GREED"/>
                    </Grid>
                </Border>

                <!-- Ctrl+7: Retreat Enemies -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="^7" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Обратить врагов в бегство (Retreat)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Все атакующие жадины пугаются и немедленно убегают назад в порталы" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Бегство" Click="BtnCheat_Click" Tag="RETREAT_ENEMIES"/>
                    </Grid>
                </Border>

                <!-- Ctrl+8: Destroy Closest Portal -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="^8" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Взорвать ближайший портал" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Взрывает портал, перед которым сейчас стоит правитель" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Ближ. портал" Click="BtnCheat_Click" Tag="DESTROY_CLOSEST_PORTAL"/>
                    </Grid>
                </Border>

                <!-- F8: Destroy Portals -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F8" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Взорвать ВСЕ порталы" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Уничтожает абсолютно все вражеские порталы на карте" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Все порталы" Click="BtnCheat_Click" Tag="DESTROY_PORTALS"/>
                    </Grid>
                </Border>

                <!-- Peaceful Mode (Disable Spawning) -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="🕊" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Мирный режим (без атак)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Отключает ночные волны жадин для спокойного строительства" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="chkSpawning" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleCheat_Click" Tag="DISABLE_SPAWNING"/>
                    </Grid>
                </Border>

                <!-- SECTION 5: МИР, ВРЕМЯ И ОСТРОВА -->
                <TextBlock Text="МИР, ВРЕМЯ И ОСТРОВА" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="4,16,0,8"/>

                <!-- Ctrl+4: Melt Snow -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="^4" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Растопить снег / Отменить зиму" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Моментально возвращает теплое время года, траву, зайцев и доход ферм" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Растопить снег" Click="BtnCheat_Click" Tag="MELT_SNOW"/>
                    </Grid>
                </Border>

                <!-- F10: Skip Day -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F10" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Пропустить день" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Перематывает время суток сразу на следующее утро" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Пропустить" Click="BtnCheat_Click" Tag="SKIP_DAY"/>
                    </Grid>
                </Border>

                <!-- F11: Pause Time -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F11" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Пауза смены дня и ночи" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Замораживает течение игрового времени суток" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="chkPauseTime" Style="{StaticResource ToggleSwitchStyle}" Click="ToggleCheat_Click" Tag="DAY_NIGHT_PAUSE"/>
                    </Grid>
                </Border>

                <!-- F12: Blood Moon -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="F12" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Кровавая Луна" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Принудительный запуск или отмена события Blood Moon" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Переключить" Click="BtnCheat_Click" Tag="BLOOD_MOON"/>
                    </Grid>
                </Border>

                <!-- Ctrl+0: Unlock Lands -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,8" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="^0" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Открыть все острова кампании (1–5)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Разблокирует мгновенный доступ ко всем землям на карте мира" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Все острова" Click="BtnCheat_Click" Tag="UNLOCK_ALL_LANDS"/>
                    </Grid>
                </Border>

                <!-- Unlock All Items & Statues -->
                <Border Background="#1C1C20" CornerRadius="8" Margin="0,0,0,24" Padding="14,10,14,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="5" Width="44" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="★" FontSize="11" FontWeight="Bold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Открыть все статуи и артефакты" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Активирует все алтари благословения (лучники, строители, скакуны)" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ActionBtnStyle}" Content="Все статуи" Click="BtnCheat_Click" Tag="UNLOCK_ALL_ITEMS"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- LOG DRAWER (Expandable) -->
        <Border Grid.Row="2" x:Name="bdrLogDrawer" Background="#121214" BorderBrush="#27272A" BorderThickness="0,1,0,0" Height="120" Visibility="Collapsed" Padding="16,8,16,8">
            <ListBox x:Name="lstLog" Background="Transparent" BorderThickness="0" Foreground="#A1A1AA" FontFamily="Consolas" FontSize="11"/>
        </Border>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="3" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="18,10,18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="dotStatus" Width="8" Height="8" Fill="#71717A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtStatus" Text="Ожидание запуска KingdomTwoCrowns.exe..." FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="btnLogToggle" Content="Журнал событий ▼" Background="Transparent" Foreground="#71717A" 
                        FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnLogToggle_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
